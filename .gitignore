node_modules/
# lib/ is committed on purpose: pnpm refuses to run a git dependency's build
# script unless the installing profile allowlists it, so a git install must not
# need one. Rebuild and commit before publishing (prepublishOnly does the build).
.test-dist/
.scratch/
*.tgz
# Local handoff docs (`.devflow/<slug>.md`): a working record for the next agent,
# not part of the package or its history. Move one to docs/ if it should persist.
.devflow/
